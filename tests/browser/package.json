{
  "name": "bookmarksync-browser-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-only harness that drives the stock, unmodified floccus extension in isolated browser profiles.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/cleanup.test.mjs test/server-sync.test.mjs test/fix-round1.test.mjs test/fix-round2.test.mjs",
    "smoke": "node smoke.mjs",
    "smoke:chromium": "node smoke.mjs --browser=chromium",
    "smoke:brave": "node smoke.mjs --browser=brave",
    "smoke:chrome": "node smoke.mjs --browser=chrome",
    "smoke:edge": "node smoke.mjs --browser=edge",
    "server-sync": "node server-sync.mjs",
    "factors": "node factors-smoke.mjs",
    "test:firefox": "node --test test/firefox-cleanup.test.mjs test/firefox-startup.test.mjs test/profile-containment.test.mjs",
    "smoke:firefox": "node firefox-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.1",
    "selenium-webdriver": "4.46.0"
  }
}
